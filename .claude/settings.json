{
  "permissions": {
    "deny": [
      "Read(./profeapp2-*.json)",
      "Read(**/profeapp2-*.json)",
      "Read(./.streamlit/secrets.toml)",
      "Bash(cat *profeapp2-*)",
      "Bash(type *profeapp2-*)",
      "Bash(head *profeapp2-*)",
      "Bash(less *profeapp2-*)",
      "PowerShell(Get-Content *profeapp2-*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/bloquear_secretos.py\""
          }
        ]
      }
    ]
  }
}
